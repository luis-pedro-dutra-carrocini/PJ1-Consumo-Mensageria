generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

// customer
model Cliente {
  ClienteId        Int      @id               // id
  ClienteNome      String   @db.VarChar(100)  // name
  ClienteEmail     String   @db.VarChar(256)  // email
  ClienteDocumento String   @db.VarChar(20)   // document

  Pedido  Pedido[]
  
}

// seller
model Vendedor {
  VendedorId      Int       @id               // id
  VendedorNome    String    @db.VarChar(100)  // name
  VendedorCidade  String    @db.VarChar(150)  // city
  VendedorUF      String    @db.VarChar(2)    // state
  
  Pedido Pedido[]

}

// category
model Categoria {
  CategoriaId   String    @id               // id
  CategoriaNome String    @db.VarChar(200)  // name

  SubCategoria  SubCategoria[]

}

// sub_category
model SubCategoria {
  SubCategoriaId    String  @id               // id
  SubCategoriaNome  String  @db.VarChar(200)  // name
  CategoriaId       String                    // category/id

  Categoria     Categoria   @relation(fields: [CategoriaId], references: [CategoriaId])
  Produto       Produto[]

}

// product
model Produto {
  ProdutoId         String      @id               // id
  ProdutoNome       String      @db.VarChar(200)  // name
  SubCategoriaId    String                        // sub_category/id

  SubCategoria  SubCategoria    @relation(fields: [SubCategoriaId], references: [SubCategoriaId])
  ItemPedido    ItemPedido[]

}

// raiz jason/ order
model Pedido {
  PedidoId             String       @id             // uuid
  PedidoDtCriacao      DateTime                     // created_at
  PedidoDtImportacao   DateTime     @default(now()) // Data/hora da indexação (não tem no json)
  PedidoTipoCriacao    String       @db.VarChar(50) // channel
  PedidoStatus         String       @db.VarChar(30) // status
  PedidoValorTotal     Decimal                      // total
  ClienteId            Int                          // customer/id
  VendedorId           Int                          // seller/id
  
  Cliente              Cliente      @relation(fields: [ClienteId], references: [ClienteId])
  Vendedor             Vendedor     @relation(fields: [VendedorId], references: [VendedorId])
  ItemPedido           ItemPedido[]
  MetadadosPedido      MetadadosPedido[]
  PagamentoPedido      PagamentoPedido[]
  CarregamentoPedido   CarregamentoPedido[]

}

// items
model ItemPedido {
  ItemPedidoId            Int     // id
  PedidoId                String  // order/uuid
  ProdutoId               String  // product/id
  ItemPedidoQuantidade    Int     // quantity
  ItemPedidoPrecoUnitario Decimal // unit_price
  ItemPedidoValorTotal    Decimal // total

  Pedido    Pedido  @relation(fields: [PedidoId], references: [PedidoId])
  Produto   Produto @relation(fields: [ProdutoId], references: [ProdutoId])

  @@id([ItemPedidoId, PedidoId])

}

// metadata
model MetadadosPedido {
  MetadadosPedidoId       String    @id @default(uuid()) // id (não tem no json)
  PedidoId                String                         // order/id
  MetadadosSource         String    @db.VarChar(100)     // source
  MetadadosUserAgent      String    @db.VarChar(150)     // user_agent
  MetadadosIP             String    @db.VarChar(100)     // ip_address

  Pedido    Pedido  @relation(fields: [PedidoId], references: [PedidoId])

}

// payment
model PagamentoPedido {
  PagamentoPedidoId       String    @id @default(uuid())  // id (não tem no json)
  PedidoId                String                          // order/id
  PagamentoMetodo         String    @db.VarChar(100)      // method
  PagamentoStatus         String    @db.VarChar(30)       // status
  PagamentoTransacao      String    @db.VarChar(200)      // transaction_id

  Pedido    Pedido  @relation(fields: [PedidoId], references: [PedidoId])

}

model CarregamentoPedido {
  CarregamentoPedidoId        String    @id @default(uuid())  // id (não tem no json)
  PedidoId                    String                          // order/id
  CarregamentoOperadora       String    @db.VarChar(200)      // carrier
  CarregamentoServico         String    @db.VarChar(200)      // service
  CarregamentoStatus          String    @db.VarChar(30)       // status
  CarregamentoCodigoRastreio  String    @db.VarChar(200)      // tracking_code

  Pedido    Pedido  @relation(fields: [PedidoId], references: [PedidoId])

}
